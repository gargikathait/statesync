# Copy to apps/api/.env for native (non-Docker) development. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql://statesync:statesync_dev@localhost:5432/statesync
# Neon: DATABASE_URL is the pooled string, DATABASE_URL_DIRECT the direct one (used by migrations).
# DATABASE_URL_DIRECT=
SECRET_KEY=dev-only-insecure-secret-key-change-me-0123456789
COOKIE_NAME=statesync_session
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_MISSING_ORIGIN=true
TRUSTED_PROXY_COUNT=0
TEST_DATABASE_URL=postgresql://statesync:statesync_dev@localhost:5432/statesync_test

# Production (Render) must instead set, and the app refuses to start otherwise:
#   ENVIRONMENT=production
#   SECRET_KEY=<python -c "import secrets; print(secrets.token_urlsafe(48))">
#   COOKIE_NAME=__Host-statesync_session   COOKIE_SECURE=true   (no COOKIE_DOMAIN)
#   ALLOWED_ORIGINS=https://<your-vercel-domain>   ALLOW_MISSING_ORIGIN=false
